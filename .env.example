RPC_URL=https://injectiveevm-testnet-rpc.polkachu.com
PRIVATE_KEY=replace_with_your_private_key
CONTRACT_ADDRESS=replace_with_deployed_contract_address
VERIFIER_URL=https://testnet.blockscout-api.injective.network/api/
GAS_PRICE=160000000
GAS_LIMIT=2000000
INCREMENT_AMOUNT=1

# --- MindReset Quote/0 e-ink display (告警输出屏) ---
DOT_API_KEY=replace_with_dot_app_api_key
DOT_DEVICE_ID=replace_with_uppercase_12hex_serial
DASHBOARD_URL=

# --- Voice alert (语音播报输出) ---
# VOICE_ENABLED=0 静音（CI/无声环境）；默认 1
VOICE_ENABLED=1
# zh=中文(Ting-Ting) / en=英文(Samantha)
VOICE_LANG=zh
# 预渲染真人音色目录（相对 repo 根）；缺文件自动降级到系统 say
AUDIO_DIR=audio

# --- T5 板载喇叭（TCP 送 16k wav，t5_voice.py / send_wav.py） ---
# T5 的 IPv4 地址（路由器 DHCP 分配，换网络会变，不要硬编码）；留空则跳过 T5 播报，只走 Mac say 兜底
T5_IP=

# --- T5AI-Core 串口（fallback 传输/烧录/调试）---
T5_PORT=/dev/cu.usbmodem5AAE1667591
T5_BAUD=115200
T5_ENABLED=1

# --- Ditto → T5 Wi-Fi 主链（TuyaOpenClaw WebSocket）---
# T5 配网后的局域网 IP；留空则传输层自动降级到签名 Serial fallback
DITTO_T5_HOST=
DITTO_T5_WS_PORT=18789
DITTO_ACK_TIMEOUT=6

# --- Quote/0 Canvas 富界面（QUOTE_CANVAS=1 走 canvas，需在 App 里给 Loop 加 Canvas API 项）---
QUOTE_CANVAS=1

# --- Ditto Gateway 私钥（绝不进 Git；由 ditto_alert.generate_keypair() 生成）---
# 路径固定: ~/Library/Application Support/Ditto/keys/gateway-private.pem (0600)
